# Next.js environment variable example.

# Base URL for comments, danmaku and other backend APIs.
# Leave empty for same-origin relative paths (default, matches the old Vite SPA).
API_BASE_URL=

# Shared HMAC-SHA256 signing key used by both the client (to sign write
# requests) and the edge API handlers (to verify them). Must be at least
# 32 bytes (64 hex characters).
# NOTE: this is exposed to the browser. Phase 3b will replace client-side
# signing with a server-side proxy / token-based flow.
API_SECRET_KEY=

# Cesium Ion access token (free at https://ion.cesium.com/).
# The globe currently uses Gaode tiles; the token is only a fallback for Ion assets.
# Leave empty to skip token injection.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Dev API rewrite target. next.config.ts proxies /api/* to this host in development.
# Default: https://sakurain.net (production API).
# Set to a local server URL (e.g., http://localhost:8788) only if you run a custom mock backend.
DEV_API_TARGET=

# Search engine sitemap submission tokens (optional).
# BING_API_KEY: Bing Webmaster URL Submission API key (primary engine).
# BAIDU_PUSH_TOKEN: Baidu ordinary push token.
# GOOGLE_SERVICE_ACCOUNT_JSON: Google service-account JSON for Search Console API.
# SEARCH_ENGINE_SUBMIT: Comma-separated engine list (default: bing,baidu).
BING_API_KEY=
BAIDU_PUSH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
SEARCH_ENGINE_SUBMIT=bing,baidu
