# Next.js (next-app) 环境变量示例
# 复制为 .env.local 并按需填写；所有变量均以 NEXT_PUBLIC_ 前缀暴露给客户端。

# 评论系统等后端 API 的基础地址。
# 留空 = 同源相对路径（默认行为，与旧版 Vite 一致）。
NEXT_PUBLIC_API_BASE_URL=

# 前端请求签名用的密钥（HMAC-SHA256，64 位十六进制）。
# 留空 = 评论提交等需要鉴权的写操作不可用（组件有错误态，只读浏览不受影响）。
NEXT_PUBLIC_API_SECRET_KEY=

# Cesium Ion 访问令牌（https://ion.cesium.com/ 免费申请）。
# 地球影像实际使用高德瓦片，token 仅用于 Cesium 内部 Ion 资源兜底；
# 留空 = 不注入 token，仅当用到 Ion 资产时才需要。
NEXT_PUBLIC_CESIUM_ION_TOKEN=
